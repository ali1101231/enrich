{
  "name": "@koldify/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @koldify/shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build -w @koldify/shared",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build -w @koldify/shared",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema ../web/prisma/schema.prisma"
  },
  "dependencies": {
    "@koldify/shared": "file:../../packages/shared",
    "@prisma/client": "^6.12.0",
    "axios": "^1.13.6",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
