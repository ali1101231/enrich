generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  DISPATCHED
  RUNNING
  COMPLETED
  FAILED
}

enum BatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum BatchSourceType {
  CSV_UPLOAD
  PASTED_ROWS
}

enum JobResultStatus {
  SUCCESS
  FAILURE
  SKIPPED
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

enum SupportMessageSenderRole {
  USER
  ADMIN
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  passwordHash   String?
  displayName    String?
  role           String             @default("user")
  isActive       Boolean            @default(true)
  credits        Int                @default(0)
  lastDequeuedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    ApiKeyAssignment[]
  batches        Batch[]
  jobs           Job[]
  exports        BatchExport[]
  offerRedemptions OfferRedemption[]
  offersCreated  Offer[]           @relation("OfferCreatedBy")
  guidesCreated  Guide[]           @relation("GuideCreatedBy")
  newsCreated    News[]            @relation("NewsCreatedBy")
  supportTickets SupportTicket[]   @relation("SupportTicketUser")
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketMessageSender")

  @@map("users")
}

model Guide {
  id          String   @id @default(cuid())
  title       String
  content     String
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("GuideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
  @@map("guides")
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
  @@map("news")
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  subject   String
  status    SupportTicketStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String                   @id @default(cuid())
  ticketId   String
  senderId   String
  senderRole SupportMessageSenderRole
  message    String
  createdAt  DateTime                 @default(now())
  ticket     SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User                     @relation("SupportTicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderId, createdAt])
  @@map("support_ticket_messages")
}

model ApiKey {
  id                String             @id @default(cuid())
  label             String
  encryptedKey      String
  isActive          Boolean            @default(true)
  maxUsers          Int                @default(20)
  requestsPerSecond Int                @default(3)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assignments       ApiKeyAssignment[]
  jobs              Job[]

  @@map("api_keys")
}

model ApiKeyAssignment {
  id        String   @id @default(cuid())
  userId    String
  apiKeyId  String
  isManual  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([apiKeyId, isActive])
  @@map("api_key_assignments")
}

model Batch {
  id               String         @id @default(cuid())
  userId           String
  toolId           String?
  sourceType       BatchSourceType
  originalFileName String?
  r2Key            String?
  totalRows        Int
  chunkSize        Int
  status           BatchStatus    @default(QUEUED)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs             Job[]
  exports          BatchExport[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("batches")
}

model Job {
  id           String      @id @default(cuid())
  batchId      String
  userId       String
  apiKeyId     String?
  sequence     Int
  rowCount     Int
  status       JobStatus   @default(QUEUED)
  attempts     Int         @default(0)
  maxAttempts  Int         @default(5)
  payload      Json
  queuedAt     DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  results      JobResult[]

  @@unique([batchId, sequence])
  @@index([batchId, status])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([apiKeyId, status, createdAt])
  @@map("jobs")
}

model JobResult {
  id         String          @id @default(cuid())
  jobId       String
  status      JobResultStatus
  attempt     Int
  rowIndex    Int?
  response    Json?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_results")
}

model BatchExport {
  id        String   @id @default(cuid())
  batchId   String
  userId    String
  r2Key     String
  fileName  String
  rowCount  Int
  fileSize  Int
  createdAt DateTime @default(now())
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([userId, createdAt])
  @@map("exports")
}

model Package {
  id            String   @id @default(cuid())
  name          String
  credits       Int
  monthlyPrice  Float
  yearlyPrice   Float
  isTopLevel    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isHighlighted Boolean  @default(false)
  badge         String?
  subtitle      String?
  buttonText    String   @default("Get Started")
  features      Json     @default("[]")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("packages")
}

model Tool {
  id          String   @id @default(cuid())
  toolId      String   @unique
  name        String
  description String?
  creditCost  Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tools")
}

model Offer {
  id             String            @id @default(cuid())
  title          String
  description    String?
  credits        Int
  maxRedemptions Int
  redeemedCount  Int               @default(0)
  isActive       Boolean           @default(true)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  redemptions    OfferRedemption[]
  createdBy      User?             @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
  @@map("offers")
}

model OfferRedemption {
  id        String   @id @default(cuid())
  offerId   String
  userId    String
  credits   Int
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([offerId, createdAt])
  @@index([userId, createdAt])
  @@map("offer_redemptions")
}

model WebsiteLogo {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  altText   String?
  href      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model WebsiteTestimonial {
  id          String   @id @default(uuid())
  clientName  String
  clientRole  String?
  companyName String?
  quote       String
  avatarUrl   String?
  rating      Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model WebsiteFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}
