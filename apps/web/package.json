{
  "name": "@koldify/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @koldify/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @koldify/shared",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build -w @koldify/shared",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@koldify/shared": "file:../../packages/shared",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.12.0"
  }
}
