{
  "name": "@koldify/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @koldify/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @koldify/shared",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build -w @koldify/shared",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@koldify/shared": "file:../../packages/shared",
    "@prisma/client": "^6.12.0",
    "bullmq": "^5.58.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "prisma": "^6.12.0"
  }
}
