# Root shared environment
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/koldify_ops_hub
REDIS_URL=redis://localhost:6379

# Web service
WEB_PORT=4000
CHUNK_SIZE_DEFAULT=10
SCHEDULER_POLL_MS=1000
SCHEDULER_MAX_ENQUEUE=50
PER_USER_ACTIVE_JOB_LIMIT=3
JWT_SECRET=change-me-to-a-random-secret
BLITZ_API_BASE_URL=https://api.blitz.example
BLITZ_API_TIMEOUT_MS=15000

# Worker
WORKER_CONCURRENCY=10
BULLMQ_PREFIX=koldify
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_MS=2000
